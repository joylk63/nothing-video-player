<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nothing_black"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="NOTHING / PLAYER"
            android:textColor="@color/nothing_white"
            android:textSize="20sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/nothing_red" />
    </LinearLayout>

    <TextView
        android:id="@+id/nowPlayingLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="NOW PLAYING  /  SELECT A VIDEO"
        android:textColor="@color/nothing_muted"
        android:textSize="11sp"
        android:letterSpacing="0.08" />

    <FrameLayout
        android:id="@+id/playerFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:clipToOutline="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"
            android:use_controller="true"
            android:show_buffering="when_playing"
            android:resize_mode="fit" />

        <TextView
            android:id="@+id/gestureHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#99000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="DOUBLE TAP: ±10s   •   SWIPE: BRIGHTNESS / VOLUME"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/videoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:text="No video selected"
        android:textColor="@color/nothing_white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/openVideosButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/nothing_red"
            android:text="＋  OPEN VIDEOS"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/subtitleButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#242424"
            android:text="CC"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/speedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#242424"
            android:text="1.0×"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="UP NEXT"
            android:textColor="@color/nothing_white"
            android:textSize="14sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/playlistCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00 ITEMS"
            android:textColor="@color/nothing_red"
            android:textSize="10sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistView"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />
</LinearLayout>
